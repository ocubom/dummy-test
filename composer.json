{
    "name" : "ocubom/base-convert",
    "type": "library",
    "description" : "Safe number conversion between arbitrary bases.",
    "keywords" : [
        "big",
        "number",
        "base",
        "base32",
        "base",
        "binary",
        "hexadecimal",
        "crockford",
        "big number",
        "precision",
        "arbitrary precision"
    ],
    "homepage" : "http://github.com/ocubom/base-convert",
    "license" : "MIT",
    "authors" : [{
        "name" : "Oscar Cubo Medina",
        "homepage" : "http://ocubom.github.io"
    }],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "suggest": {
    },
    "autoload": {
        "psr-4": { "Ocubom\\Math\\": "src/" },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": { "Ocubom\\Math\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
